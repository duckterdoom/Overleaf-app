{
  "name": "overleaf-desktop-ui",
  "version": "0.1.0",
  "private": true,
  "overrides": {
    "pdfjs-dist": "$pdfjs-dist"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "prebuild": "node scripts/copy-worker.mjs",
    "build": "next build --webpack",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "node tests/unit/test-checklist-scores.mjs && node tests/unit/test-outline-parser.mjs && node tests/unit/test-snippets.mjs && node tests/unit/test-guide-markdown.mjs && node tests/unit/test-history-diff.mjs && node tests/unit/test-navigation-loading.mjs && node tests/unit/test-list-filters.mjs",
    "test:browser": "node tests/run.mjs",
    "test:pdf-geometry": "node tests/unit/test-pdf-geometry.mjs"
  },
  "dependencies": {
    "@codemirror/collab": "^6.1.1",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.11.0",
    "@codemirror/legacy-modes": "^6.5.0",
    "@codemirror/search": "^6.7.2",
    "@codemirror/view": "^6.43.15",
    "@uiw/react-codemirror": "^4.25.0",
    "lucide-react": "^0.577.0",
    "next": "16.4.5",
    "pdfjs-dist": "^6.2.108",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "superdoc": "^2.29.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0"
  }
}
