# Replace credentials on the server. Keep the environment file out of Git.
OVERLEAF_HOST=0.0.0.0
OVERLEAF_PORT=8080
OVERLEAF_MAX_CLIENTS=64
OVERLEAF_IDLE_TIMEOUT_MS=60000
OVERLEAF_QUEUE_CAPACITY=32
OVERLEAF_MAX_DOCUMENT_CHARS=100000
OVERLEAF_TLS=true
OVERLEAF_TOKEN=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_24_CHARACTERS
OVERLEAF_KEYSTORE=/etc/overleaf/server.p12
OVERLEAF_KEYSTORE_PASSWORD=REPLACE_WITH_KEYSTORE_PASSWORD
